  "version": "0.6.0",
  "description": "Interactive 3D cell atlas of microalgae and cyanobacteria, sourced and confidence-tiered. First specimen: Spirulina (Limnospira platensis).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
